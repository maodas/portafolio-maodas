---
// ================= FOOTER (spec §3.8) =================
// One line only. No legal links, no social icons, no taglines.
// Content is language-neutral (same in ES and EN).
---

<footer class="site-footer max-w-content mx-auto px-8 py-6">
  <div class="footer-inner font-mono">
    <span class="footer-copy">© 2026 maodas.online</span>
    <span class="footer-location">Guatemala · UTC-6</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 11px;
    color: var(--muted);
  }

  /* Mobile: keep on one line; shrink gracefully */
  @media (max-width: 400px) {
    .footer-inner {
      flex-direction: column;
      gap: 0.25rem;
      align-items: flex-start;
    }
  }
</style>