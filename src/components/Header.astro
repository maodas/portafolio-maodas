---
// ================= HEADER SIMPLIFICADO =================
// Con soporte i18n
import { useTranslations } from '../i18n/ui';

const lang = Astro.currentLocale || 'en';
const t = useTranslations(lang as any);
const basePath = lang === 'es' ? '/es' : '';

// Lógica de route switching
const { pathname } = Astro.url;
const toggleLang = lang === 'en' ? 'es' : 'en';
let toggleHref = pathname;

if (lang === 'en' && toggleLang === 'es') {
  toggleHref = '/es' + pathname;
  if (pathname === '/') toggleHref = '/es/';
} else if (lang === 'es' && toggleLang === 'en') {
  toggleHref = pathname.replace(/^\/es/, '');
  if (toggleHref === '') toggleHref = '/';
}
---

<header class="sticky top-0 z-50 bg-white/80 dark:bg-gray-900/80 backdrop-blur-md border-b border-gray-200 dark:border-gray-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Logo -->
      <div class="flex items-center">
        <a href={`${basePath}/`} class="flex items-center space-x-3">
          <img src="/logo.svg" alt="maodas.online logo" class="w-10 h-10 object-contain" loading="lazy" />
          <div>
            <div class="text-xl font-bold text-gray-900 dark:text-white">maodas.online</div>
            <div class="text-xs text-gray-500 dark:text-gray-400">{t('header.subtitle')}</div>
          </div>
        </a>
      </div>

      <!-- Navegación Desktop -->
      <nav class="hidden md:flex items-center space-x-6 lg:space-x-8">
        <a href={`${basePath}/`} class="text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors font-medium py-2 relative group">
          {t('nav.inicio')}
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-blue-600 group-hover:w-full transition-all duration-300"></span>
        </a>
        <a href={`${basePath}/#about`} class="text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors font-medium py-2 relative group">
          {t('nav.sobre-mi')}
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-blue-600 group-hover:w-full transition-all duration-300"></span>
        </a>
        <a href={`${basePath}/#experience`} class="text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors font-medium py-2 relative group">
          {t('nav.experiencia')}
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-blue-600 group-hover:w-full transition-all duration-300"></span>
        </a>
        <a href={`${basePath}/#projects`} class="text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors font-medium py-2 relative group">
          {t('nav.proyectos')}
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-blue-600 group-hover:w-full transition-all duration-300"></span>
        </a>
        <a href={`${basePath}/blog`} class="text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors font-medium py-2 relative group">
          {t('nav.blog')}
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-blue-600 group-hover:w-full transition-all duration-300"></span>
        </a>
        <a href={`${basePath}/#contact`} class="text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors font-medium py-2 relative group">
          {t('nav.contacto')}
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-blue-600 group-hover:w-full transition-all duration-300"></span>
        </a>
        
        <!-- Toggle Lenguaje y Tema -->
        <div class="flex items-center pl-4 border-l border-gray-200 dark:border-gray-700 space-x-2">
          <a href={toggleHref} data-lang={toggleLang} class="btn-lang-toggle px-3 py-1.5 text-sm font-bold bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 rounded border border-blue-200 dark:border-blue-800 hover:bg-blue-200 dark:hover:bg-blue-800/60 shadow-sm transition-all focus:ring-2 focus:ring-blue-500 flex items-center gap-1">
            <span class="text-xs font-normal">🌐</span> {lang === 'es' ? 'EN' : 'ES'}
          </a>
          <button
            id="theme-toggle"
            class="p-2 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
            aria-label="Cambiar tema"
          >
            <span id="theme-icon">🌙</span>
          </button>
        </div>
      </nav>

      <!-- Botones Móvil -->
      <div class="md:hidden flex items-center space-x-3">
        <a href={toggleHref} data-lang={toggleLang} class="btn-lang-toggle px-3 py-1.5 text-xs font-bold bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 rounded border border-blue-200 dark:border-blue-800 hover:bg-blue-200 dark:hover:bg-blue-800/60 shadow-sm transition-all flex items-center gap-1">
          <span class="text-xs font-normal">🌐</span> {lang === 'es' ? 'EN' : 'ES'}
        </a>
        <button
          id="theme-toggle-mobile"
          class="p-2 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
          aria-label="Cambiar tema"
        >
          <span id="theme-icon-mobile">🌙</span>
        </button>
        <button 
          id="menu-toggle"
          class="p-2 rounded-md text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800"
        >
          ☰
        </button>
      </div>
    </div>

    <!-- Menú Móvil -->
    <div id="mobile-menu" class="md:hidden border-t border-gray-200 dark:border-gray-800 py-4 hidden">
      <div class="flex flex-col space-y-3">
        <a href={`${basePath}/`} class="text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 py-2 px-4 hover:bg-gray-50 dark:hover:bg-gray-800 rounded-lg transition-colors">
          {t('nav.inicio')}
        </a>
        <a href={`${basePath}/#about`} class="text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 py-2 px-4 hover:bg-gray-50 dark:hover:bg-gray-800 rounded-lg transition-colors">
          {t('nav.sobre-mi')}
        </a>
        <a href={`${basePath}/#experience`} class="text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 py-2 px-4 hover:bg-gray-50 dark:hover:bg-gray-800 rounded-lg transition-colors">
          {t('nav.experiencia')}
        </a>
        <a href={`${basePath}/#projects`} class="text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 py-2 px-4 hover:bg-gray-50 dark:hover:bg-gray-800 rounded-lg transition-colors">
          {t('nav.proyectos')}
        </a>
        <a href={`${basePath}/blog`} class="text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 py-2 px-4 hover:bg-gray-50 dark:hover:bg-gray-800 rounded-lg transition-colors">
          {t('nav.blog')}
        </a>
        <a href={`${basePath}/#contact`} class="text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 py-2 px-4 hover:bg-gray-50 dark:hover:bg-gray-800 rounded-lg transition-colors">
          {t('nav.contacto')}
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  function getCurrentTheme(): string {
    const savedTheme = localStorage.getItem('theme');
    if (savedTheme) return savedTheme;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function applyTheme(theme: string) {
    if (theme === 'dark') {
      document.documentElement.classList.add('dark');
      document.querySelectorAll('#theme-icon, #theme-icon-mobile').forEach(icon => {
        icon.textContent = '☀️';
      });
    } else {
      document.documentElement.classList.remove('dark');
      document.querySelectorAll('#theme-icon, #theme-icon-mobile').forEach(icon => {
        icon.textContent = '🌙';
      });
    }
    localStorage.setItem('theme', theme);
  }

  function toggleTheme() {
    applyTheme(getCurrentTheme() === 'dark' ? 'light' : 'dark');
  }

  function toggleMobileMenu() {
    const menu = document.getElementById('mobile-menu');
    const button = document.getElementById('menu-toggle');
    if (menu && button) {
      if (menu.classList.contains('hidden')) {
        menu.classList.remove('hidden');
        button.textContent = '✕';
      } else {
        menu.classList.add('hidden');
        button.textContent = '☰';
      }
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    applyTheme(getCurrentTheme());
    document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
    document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);
    document.getElementById('menu-toggle')?.addEventListener('click', toggleMobileMenu);
    
    document.querySelectorAll('.btn-lang-toggle').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const targetLang = (e.currentTarget as HTMLElement).getAttribute('data-lang');
        if (typeof (window as any).gtag === 'function') {
          (window as any).gtag('event', 'language_switch', {
            'event_category': 'engagement',
            'event_label': targetLang
          });
        }
      });
    });

    document.querySelectorAll('#mobile-menu a').forEach(link => {
      link.addEventListener('click', () => {
        document.getElementById('mobile-menu')?.classList.add('hidden');
        const menuToggle = document.getElementById('menu-toggle');
        if (menuToggle) menuToggle.textContent = '☰';
      });
    });
    
    document.querySelectorAll('a[href^="#"], a[href^="/#"], a[href^="/en/#"]').forEach(anchor => {
      anchor.addEventListener('click', function(this: HTMLElement, e: Event) {
        const href = this.getAttribute('href') || '';
        const targetIdMatch = href.match(/#([a-zA-Z0-9_-]+)$/);
        
        // Si no estamos en la homepage y hacemos clic en enlace a homepage section, 
        // dejar que el navegador haga la navegación por defecto
        if (window.location.pathname !== '/' && window.location.pathname !== '/en/' && window.location.pathname !== '/en') {
          return; 
        }

        if (targetIdMatch) {
          const targetId = '#' + targetIdMatch[1];
          const targetElement = document.querySelector(targetId) as HTMLElement;
          if (targetElement) {
            e.preventDefault();
            document.getElementById('mobile-menu')?.classList.add('hidden');
            const menuToggle = document.getElementById('menu-toggle');
            if (menuToggle) menuToggle.textContent = '☰';
            
            window.scrollTo({
              top: targetElement.offsetTop - 80,
              behavior: 'smooth'
            });
            history.pushState(null, '', href);
          }
        }
      });
    });
  });

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    if (!localStorage.getItem('theme')) applyTheme(e.matches ? 'dark' : 'light');
  });
</script>

<style>
  * { transition: background-color 0.3s ease, border-color 0.3s ease; }
</style>