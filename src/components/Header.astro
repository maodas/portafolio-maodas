---
// ================= HEADER (spec §3.1) =================
// Removed: CV download button
// Kept: logo · nav anchors · status badge · lang toggle · dark mode toggle
import { useTranslations } from '../i18n/ui';

const lang = Astro.currentLocale || 'en';
const t = useTranslations(lang as any);
const basePath = lang === 'es' ? '/es' : '';

// Language route switching logic (preserved)
const { pathname } = Astro.url;
const toggleLang = lang === 'en' ? 'es' : 'en';
let toggleHref = pathname;

if (lang === 'en' && toggleLang === 'es') {
  toggleHref = '/es' + pathname;
  if (pathname === '/') toggleHref = '/es/';
} else if (lang === 'es' && toggleLang === 'en') {
  toggleHref = pathname.replace(/^\/es/, '');
  if (toggleHref === '') toggleHref = '/';
}

const navLinks = lang === 'es'
  ? [
      { href: `${basePath}/#experience`, label: 'experiencia' },
      { href: `${basePath}/#projects`,   label: 'proyectos'  },
      { href: `${basePath}/#contact`,    label: 'contacto'   },
    ]
  : [
      { href: `${basePath}/#experience`, label: 'experience' },
      { href: `${basePath}/#projects`,   label: 'projects'   },
      { href: `${basePath}/#contact`,    label: 'contact'    },
    ];

const availableLabel = lang === 'es' ? 'disponible' : 'available';
---

<header class="header-root sticky top-0 z-50 border-b" style="border-color: var(--border);">
  <div class="max-w-content mx-auto px-12">
    <div class="flex items-center justify-between h-14">

      <!-- Wordmark / logo -->
      <a href={`${basePath}/`} class="font-mono text-sm font-normal transition-colors" style="color: var(--text);">
        maodas.online
      </a>

      <!-- Desktop navigation -->
      <nav class="hidden md:flex items-center gap-8" aria-label="Main navigation">
        {navLinks.map(link => (
          <a href={link.href} class="nav-link font-mono text-xs tracking-wider">
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Right controls -->
      <div class="flex items-center gap-4">

        <!-- Availability badge -->
        <div class="hidden sm:flex items-center gap-1.5">
          <span class="status-dot w-1.5 h-1.5 rounded-full" style="background: var(--accent);"></span>
          <span class="font-mono uppercase tracking-widest" style="font-size: 10px; color: var(--accent);">
            {availableLabel}
          </span>
        </div>

        <!-- Vertical rule -->
        <div class="hidden sm:block w-px h-3" style="background: var(--border-hi);"></div>

        <!-- Language toggle -->
        <a
          href={toggleHref}
          data-lang={toggleLang}
          class="btn-lang-toggle font-mono text-xs transition-colors"
          style="color: var(--muted);"
          aria-label={`Switch language to ${lang === 'es' ? 'EN' : 'ES'}`}
        >
          {lang === 'es' ? 'EN' : 'ES'}
        </a>

        <!-- Theme toggle -->
        <button
          id="theme-toggle"
          class="btn-theme-toggle"
          title="Toggle theme"
          aria-label="Toggle theme"
          style="font-family: DM Mono; font-size: 11px; color: var(--muted); border: 1px solid var(--border-hi); border-radius: 4px; padding: 3px 10px; background: transparent; cursor: pointer; letter-spacing: 0.06em; transition: color 0.2s, border-color 0.2s;"
        >
          <span id="theme-icon" class="theme-label">light</span>
        </button>

        <!-- Mobile hamburger -->
        <button
          id="menu-toggle"
          class="md:hidden font-mono text-xs"
          style="color: var(--muted); background: none; border: none; cursor: pointer; padding: 0;"
          aria-label="Toggle menu"
        >
          ☰
        </button>

      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="md:hidden border-t py-5 hidden" style="border-color: var(--border);">
      <div class="flex flex-col gap-5">
        {navLinks.map(link => (
          <a href={link.href} class="nav-link font-mono text-xs tracking-wider">
            {link.label}
          </a>
        ))}
        <!-- Availability in mobile -->
        <div class="flex items-center gap-1.5 pt-3 border-t" style="border-color: var(--border);">
          <span class="status-dot w-1.5 h-1.5 rounded-full" style="background: var(--accent);"></span>
          <span class="font-mono uppercase tracking-widest" style="font-size: 10px; color: var(--accent);">
            {availableLabel}
          </span>
        </div>
      </div>
    </div>

  </div>
</header>

<script>
  // ── Theme helpers ──────────────────────────────────────────────
  function getCurrentTheme(): string {
    const saved = localStorage.getItem('theme');
    if (saved) return saved;
    return 'dark'; // Default is always dark (spec §1.4)
  }

  function applyTheme(theme: string) {
    if (theme === 'dark') {
      document.documentElement.classList.add('dark');
      document.querySelectorAll('#theme-icon, #theme-icon-mobile').forEach(el => {
        el.textContent = 'light'; // dark mode active — toggle to light
      });
    } else {
      document.documentElement.classList.remove('dark');
      document.querySelectorAll('#theme-icon, #theme-icon-mobile').forEach(el => {
        el.textContent = 'dark'; // light mode active — toggle to dark
      });
    }
    localStorage.setItem('theme', theme);
  }

  function toggleTheme() {
    applyTheme(getCurrentTheme() === 'dark' ? 'light' : 'dark');
  }

  // ── Mobile menu ────────────────────────────────────────────────
  function toggleMobileMenu() {
    const menu   = document.getElementById('mobile-menu');
    const button = document.getElementById('menu-toggle');
    if (menu && button) {
      const isHidden = menu.classList.contains('hidden');
      menu.classList.toggle('hidden', !isHidden);
      button.textContent = isHidden ? '✕' : '☰';
    }
  }

  // ── Smooth scroll (same logic as before) ──────────────────────
  function setupSmoothScroll() {
    document.querySelectorAll('a[href^="#"], a[href*="/#"], a[href*="/es/#"]').forEach(anchor => {
      anchor.addEventListener('click', function (this: HTMLElement, e: Event) {
        const href = this.getAttribute('href') || '';
        const match = href.match(/#([a-zA-Z0-9_-]+)$/);
        // Only intercept if we're on the homepage
        const isHome = ['/', '/es/', '/en/'].includes(window.location.pathname) ||
                       window.location.pathname === '';
        if (!isHome) return;

        if (match) {
          const target = document.querySelector('#' + match[1]) as HTMLElement | null;
          if (target) {
            e.preventDefault();
            document.getElementById('mobile-menu')?.classList.add('hidden');
            const btn = document.getElementById('menu-toggle');
            if (btn) btn.textContent = '☰';
            window.scrollTo({ top: target.offsetTop - 56, behavior: 'smooth' });
            history.pushState(null, '', href);
          }
        }
      });
    });
  }

  // ── Bootstrap on each Astro page load ─────────────────────────
  document.addEventListener('astro:page-load', () => {
    applyTheme(getCurrentTheme());

    document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
    document.getElementById('menu-toggle')?.addEventListener('click', toggleMobileMenu);

    // Close mobile menu when a link inside it is clicked
    document.querySelectorAll('#mobile-menu a').forEach(link => {
      link.addEventListener('click', () => {
        document.getElementById('mobile-menu')?.classList.add('hidden');
        const btn = document.getElementById('menu-toggle');
        if (btn) btn.textContent = '☰';
      });
    });

    // Language switch analytics
    document.querySelectorAll('.btn-lang-toggle').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const targetLang = (e.currentTarget as HTMLElement).getAttribute('data-lang');
        if (typeof (window as any).gtag === 'function') {
          (window as any).gtag('event', 'language_switch', {
            event_category: 'engagement',
            event_label: targetLang,
          });
        }
      });
    });

    setupSmoothScroll();
  });

  // System theme change listener
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    if (!localStorage.getItem('theme')) applyTheme(e.matches ? 'dark' : 'light');
  });
</script>

<style>
  /* Header background — semi-transparent with blur, adapts to light/dark */
  .header-root {
    background: rgba(14, 14, 14, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  html:not(.dark) .header-root {
    background: rgba(250, 250, 248, 0.92);
  }

  /* Nav links */
  .nav-link {
    color: var(--muted);
    transition: color 0.15s ease;
    text-decoration: none;
  }
  .nav-link:hover {
    color: var(--text);
  }

  /* Status dot pulse (CSS only) */
  @media (prefers-reduced-motion: no-preference) {
    .status-dot {
      animation: pulse-dot 2.5s ease-in-out infinite;
    }
    @keyframes pulse-dot {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0.4; }
    }
  }

  /* Theme toggle button */
  .btn-theme-toggle:hover {
    color: var(--text) !important;
    border-color: var(--muted) !important;
  }

  /* Smooth color transitions for theme toggle */
  * {
    transition: background-color 0.25s ease, border-color 0.25s ease, color 0.15s ease;
  }
</style>