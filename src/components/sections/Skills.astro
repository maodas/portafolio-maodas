        <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 text-center">
          <span class="text-2xl mb-2 block">🧩</span>
          <span class="font-semibold text-gray-900 dark:text-white">Resolución problemas</span>
        </div>
        <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 text-center">
          <span class="text-2xl mb-2 block">⏱️</span>
          <span class="font-semibold text-gray-900 dark:text-white">Gestión de tiempo</span>
        </div>
        <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 text-center">
          <span class="text-2xl mb-2 block">🔄</span>
          <span class="font-semibold text-gray-900 dark:text-white">Adaptabilidad</span>
        </div>
        <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 text-center">
          <span class="text-2xl mb-2 block">🎨</span>
          <span class="font-semibold text-gray-900 dark:text-white">Creatividad</span>
        </div>
        <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 text-center">
          <span class="text-2xl mb-2 block">📊</span>
