---
// ================= SECCIÓN HABILIDADES =================
// Propósito: Mostrar habilidades técnicas y blandas
---

<div class="max-w-7xl mx-auto">
  
  <!-- Encabezado -->
  <div class="text-center mb-16">
    <h2 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6">
      Mis <span class="text-blue-600 dark:text-blue-400">Habilidades</span>
    </h2>
    <div class="w-24 h-1 bg-gradient-to-r from-blue-500 to-purple-500 mx-auto rounded-full"></div>
    <p class="text-xl text-gray-600 dark:text-gray-300 mt-6 max-w-3xl mx-auto">
      Tecnologías y herramientas que utilizo para integrar la estrategia de negocio con soluciones técnicas eficientes.
    </p>
  </div>

  <!-- Categorías de habilidades -->
  <div class="space-y-12">
    
    <!-- Frontend -->
    <div>
      <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center">
        <span class="w-8 h-8 bg-blue-100 dark:bg-blue-900/30 rounded-lg flex items-center justify-center mr-3">
          <span class="text-blue-600 dark:text-blue-400">🌐</span>
        </span>
        Desarrollo Full-Stack
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
          <div class="flex justify-between items-center mb-2">
            <span class="font-semibold text-gray-900 dark:text-white">JS (Node.js / React)</span>
            <span class="text-sm text-gray-600 dark:text-gray-400">81%</span>
          </div>
          <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2.5">
            <div class="bg-blue-600 h-2.5 rounded-full" style="width: 81%"></div>
          </div>
        </div>
        <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
          <div class="flex justify-between items-center mb-2">
            <span class="font-semibold text-gray-900 dark:text-white">TypeScript</span>
            <span class="text-sm text-gray-600 dark:text-gray-400">63%</span>
          </div>
          <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2.5">
            <div class="bg-blue-600 h-2.5 rounded-full" style="width: 63%"></div>
          </div>
        </div>
        <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
          <div class="flex justify-between items-center mb-2">
            <span class="font-semibold text-gray-900 dark:text-white">PHP</span>
            <span class="text-sm text-gray-600 dark:text-gray-400">70%</span>
          </div>
          <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2.5">
            <div class="bg-blue-600 h-2.5 rounded-full" style="width: 70%"></div>
          </div>
        </div>
        <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
          <div class="flex justify-between items-center mb-2">
            <span class="font-semibold text-gray-900 dark:text-white">HTML/CSS</span>
            <span class="text-sm text-gray-600 dark:text-gray-400">91%</span>
          </div>
          <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2.5">
            <div class="bg-blue-600 h-2.5 rounded-full" style="width: 91%"></div>
          </div>
        </div>
        <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
          <div class="flex justify-between items-center mb-2">
            <span class="font-semibold text-gray-900 dark:text-white">Git</span>
            <span class="text-sm text-gray-600 dark:text-gray-400">75%</span>
          </div>
          <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2.5">
            <div class="bg-blue-600 h-2.5 rounded-full" style="width: 75%"></div>
          </div>
        </div>
        <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
          <div class="flex justify-between items-center mb-2">
            <span class="font-semibold text-gray-900 dark:text-white">Python</span>
            <span class="text-sm text-gray-600 dark:text-gray-400">80%</span>
          </div>
          <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2.5">
            <div class="bg-blue-600 h-2.5 rounded-full" style="width: 80%"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Backend -->
    <div>
      <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center">
        <span class="w-8 h-8 bg-purple-100 dark:bg-purple-900/30 rounded-lg flex items-center justify-center mr-3">
          <span class="text-purple-600 dark:text-purple-400">⚙️</span>
        </span>
        Inteligencia de Negocios & Data
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
          <div class="flex justify-between items-center mb-2">
            <span class="font-semibold text-gray-900 dark:text-white">Análisis Estratégico</span>
            <span class="text-sm text-gray-600 dark:text-gray-400">85%</span>
          </div>
          <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2.5">
            <div class="bg-purple-600 h-2.5 rounded-full" style="width: 85%"></div>
          </div>
        </div>
        <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
          <div class="flex justify-between items-center mb-2">
            <span class="font-semibold text-gray-900 dark:text-white">Visualización de Datos</span>
            <span class="text-sm text-gray-600 dark:text-gray-400">80%</span>
          </div>
          <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2.5">
            <div class="bg-purple-600 h-2.5 rounded-full" style="width: 80%"></div>
          </div>
        </div>
        <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
          <div class="flex justify-between items-center mb-2">
            <span class="font-semibold text-gray-900 dark:text-white">Gestión de Bases de Datos</span>
            <span class="text-sm text-gray-600 dark:text-gray-400">85%</span>
          </div>
          <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2.5">
            <div class="bg-purple-600 h-2.5 rounded-full" style="width: 85%"></div>
          </div>
        </div>
        <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
          <div class="flex justify-between items-center mb-2">
            <span class="font-semibold text-gray-900 dark:text-white">Traducción de Datos a Estrategia</span>
            <span class="text-sm text-gray-600 dark:text-gray-400">80%</span>
          </div>
          <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2.5">
            <div class="bg-purple-600 h-2.5 rounded-full" style="width: 80%"></div>
          </div>
        </div>
        <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
          <div class="flex justify-between items-center mb-2">
            <span class="font-semibold text-gray-900 dark:text-white">SQL</span>
            <span class="text-sm text-gray-600 dark:text-gray-400">75%</span>
          </div>
          <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2.5">
            <div class="bg-purple-600 h-2.5 rounded-full" style="width: 75%"></div>
          </div>
        </div>
        <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
          <div class="flex justify-between items-center mb-2">
            <span class="font-semibold text-gray-900 dark:text-white">PowerBi & Tableau</span>
            <span class="text-sm text-gray-600 dark:text-gray-400">70%</span>
          </div>
          <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2.5">
            <div class="bg-purple-600 h-2.5 rounded-full" style="width: 70%"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Automatización y Procesos -->
    <div>
      <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center">
        <span class="w-8 h-8 bg-green-100 dark:bg-green-900/30 rounded-lg flex items-center justify-center mr-3">
          <span class="text-green-600 dark:text-green-400">🛠️</span>
        </span>
        Procesos y Automatización
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
          <div class="flex justify-between items-center mb-2">
            <span class="font-semibold text-gray-900 dark:text-white">Gestión Águil (Scrum)</span>
            <span class="text-sm text-gray-600 dark:text-gray-400">80%</span>
          </div>
          <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2.5">
            <div class="bg-green-600 h-2.5 rounded-full" style="width: 80%"></div>
          </div>
        </div>
        <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
          <div class="flex justify-between items-center mb-2">
            <span class="font-semibold text-gray-900 dark:text-white">Git</span>
            <span class="text-sm text-gray-600 dark:text-gray-400">90%</span>
          </div>
          <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2.5">
            <div class="bg-green-600 h-2.5 rounded-full" style="width: 90%"></div>
          </div>
        </div>
        <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
          <div class="flex justify-between items-center mb-2">
            <span class="font-semibold text-gray-900 dark:text-white">AWS</span>
            <span class="text-sm text-gray-600 dark:text-gray-400">70%</span>
          </div>
          <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2.5">
            <div class="bg-green-600 h-2.5 rounded-full" style="width: 70%"></div>
