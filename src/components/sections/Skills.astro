    <!-- Soft Skills -->
    <div>
      <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center">
        <span class="w-8 h-8 bg-yellow-100 dark:bg-yellow-900/30 rounded-lg flex items-center justify-center mr-3">
          <span class="text-yellow-600 dark:text-yellow-400">💡</span>
        </span>
        Soft Skills
      </h3>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 text-center">
          <span class="text-2xl mb-2 block">🎯</span>
          <span class="font-semibold text-gray-900 dark:text-white">Liderazgo</span>
        </div>
        <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 text-center">
          <span class="text-2xl mb-2 block">🤝</span>
          <span class="font-semibold text-gray-900 dark:text-white">Trabajo en equipo</span>
        </div>
        <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 text-center">
