---
// ================= SKILLS (spec §3.6) =================
// 4-column grid. No bars, no stars, no percentages.
import { useTranslations } from '../../i18n/ui';

const lang = Astro.currentLocale || 'en';
const t = useTranslations(lang as any);

const columns = [
  {
    header: t('skills.col.1'),
    items: [
      'HTML / CSS',
      'JavaScript',
      'TypeScript',
      'React',
      'Astro',
      'Tailwind',
    ],
  },
  {
    header: t('skills.col.2'),
    items: [
      'Node.js',
      'Python',
      'FastAPI',
      'SQL · PostgreSQL',
      'Supabase · pgvector',
      'Firebase · GCP · AWS',
    ],
  },
  {
    header: t('skills.col.3'),
    items: [
      'n8n',
      'LangGraph',
      'RAG (Retrieval-Augmented Gen.)',
      'Twilio API',
      'WhatsApp Business API',
      'Make (Integromat)',
    ],
  },
  {
    header: t('skills.col.4'),
    items: [
      'Scrum / Agile',
      'Git · CI/CD',
      'Linux · Docker',
      'PowerBI · Tableau',
      'GitHub Actions',
      'Project Mgmt',
    ],
  },
];
---

<section id="skills" class="skills-section max-w-content mx-auto px-12 py-16">

  <!-- Section label -->
  <div class="section-label font-mono mb-10">
    <span class="section-num">{t('skills.section.num')}</span>
    <span class="section-title">/ {t('skills.section.label')}</span>
  </div>

  <!-- 4-column skill grid -->
  <div class="skills-grid">
    {columns.map((col, ci) => (
      <div class={`skill-col ${ci < columns.length - 1 ? 'col-border' : ''}`}>

        <!-- Column header -->
        <div class="col-header font-mono" style="font-size: 0.75rem;">{col.header}</div>

        <!-- Skill items -->
        {col.items.map((item, ii) => (
          <div class={`skill-item font-sans ${ii < col.items.length - 1 ? 'item-border' : ''}`} style="font-size: 0.9rem;">
            {item}
          </div>
        ))}

      </div>
    ))}
  </div>

</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {
      const prefersReducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      const columns = Array.from(
        document.querySelectorAll<HTMLElement>('#skills .skill-col')
      );

      if (prefersReducedMotion || columns.length === 0) {
        columns.forEach(col => {
          (col as HTMLElement).style.opacity = '1';
          (col as HTMLElement).style.transform = 'translateY(0)';
          (col as HTMLElement).style.transition = 'none';
        });
        return;
      }

      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            columns.forEach((col, index) => {
              setTimeout(() => {
                col.classList.add('is-visible');
              }, index * 100);
            });
            obs.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });

      const section = document.querySelector('#skills');
      if (section) observer.observe(section);
    });
  </script>

<style is:global>
  /* Section separator */
  .skills-section {
    border-top: 1px solid var(--border);
  }

  /* Section label */
  .section-label {
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .section-num   { color: var(--accent); margin-right: 0.4rem; }
  .section-title { color: var(--muted); }

  /* ── 4-column grid ────────────────────────────────────────── */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }


  /* Right border between columns (all except last) */
  .col-border {
    border-right: 1px solid var(--border);
    padding-right: 1.5rem;
    margin-right: 0;
  }
  .skill-col:not(.col-border) {
    padding-left: 1.5rem;
  }
  .skill-col.col-border + .skill-col {
    padding-left: 1.5rem;
  }

  /* Column header */
  .col-header {
    font-size: 10px;
    color: var(--accent);
    letter-spacing: 0.12em;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  /* Skill items */
  .skill-item {
    font-size: 12px;
    font-weight: 300;
    color: var(--muted);
    padding: 0.45rem 0;
    line-height: 1.4;
  }
  .item-border {
    border-bottom: 1px solid var(--border);
  }

  /* ── Tablet: 2 columns ───────────────────────────────────── */
  @media (max-width: 768px) and (min-width: 421px) {
    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    /* Reset all column borders, re-apply for 2-col layout */
    .skill-col       { padding-left: 0; padding-right: 0; border-right: none; }
    .skill-col:nth-child(odd)  { border-right: 1px solid var(--border); padding-right: 1.5rem; }
    .skill-col:nth-child(even) { padding-left: 1.5rem; }
    /* Add bottom border between the two rows */
    .skill-col:nth-child(1),
    .skill-col:nth-child(2) {
      padding-bottom: 1.5rem;
      margin-bottom: 1.5rem;
      border-bottom: 1px solid var(--border);
    }
  }

  /* ── Mobile: 1 column ────────────────────────────────────── */
  @media (max-width: 420px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
    .skill-col       { padding-left: 0; padding-right: 0; border-right: none; }
    .skill-col:not(:last-child) {
      padding-bottom: 1.5rem;
      margin-bottom: 1.5rem;
      border-bottom: 1px solid var(--border);
    }
  }
</style>