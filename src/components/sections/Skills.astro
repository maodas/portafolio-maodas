---
// ================= SECCIÓN HABILIDADES =================
import { Icon } from 'astro-icon/components';
import { useTranslations } from '../../i18n/ui';

const lang = Astro.currentLocale || 'es';
const t = useTranslations(lang as any);

const categories = [
  {
    title: t('skills.cat1'),
    icon: "lucide:layout",
    color: "blue",
    skills: [
      { name: "HTML / CSS", icon: "lucide:file-code-2" },
      { name: "JavaScript", icon: "lucide:file-json-2" },
      { name: "TypeScript", icon: "lucide:file-type-2" },
      { name: "React", icon: "lucide:atom" }
    ]
  },
  {
    title: t('skills.cat2'),
    icon: "lucide:server",
    color: "purple",
    skills: [
      { name: "Node.js", icon: "lucide:hexagon" },
      { name: "PHP", icon: "lucide:file-code" },
      { name: "Python", icon: "lucide:terminal" },
      { name: "SQL", icon: "lucide:database" },
      { name: t('skills.s.db'), icon: "lucide:hard-drive" }
    ]
  },
  {
    title: t('skills.cat3'),
    icon: "lucide:wrench",
    color: "green",
    skills: [
      { name: "Git", icon: "lucide:git-branch" },
      { name: "AWS", icon: "lucide:cloud" },
      { name: "Linux", icon: "lucide:terminal-square" },
      { name: "CI/CD", icon: "lucide:workflow" },
      { name: "Scrum", icon: "lucide:kanban" },
      { name: "PowerBI / Tableau", icon: "lucide:bar-chart-2" },
      { name: t('skills.s.leadership'), icon: "lucide:users" },
      { name: t('skills.s.comm'), icon: "lucide:message-square" },
      { name: t('skills.s.resolution'), icon: "lucide:puzzle" },
      { name: t('skills.s.time'), icon: "lucide:clock" },
      { name: t('skills.s.adapt'), icon: "lucide:refresh-cw" },
      { name: t('skills.s.creative'), icon: "lucide:palette" },
      { name: t('skills.s.analysis'), icon: "lucide:activity" }
    ]
  }
];

const colorMap: Record<string, string> = {
  blue: "bg-blue-100 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400 group-hover:bg-blue-600 group-hover:text-white dark:group-hover:bg-blue-500",
  purple: "bg-purple-100 text-purple-600 dark:bg-purple-900/30 dark:text-purple-400 group-hover:bg-purple-600 group-hover:text-white dark:group-hover:bg-purple-500",
  green: "bg-green-100 text-green-600 dark:bg-green-900/30 dark:text-green-400 group-hover:bg-green-600 group-hover:text-white dark:group-hover:bg-green-500"
};

const headerColorMap: Record<string, string> = {
  blue: "bg-blue-100 text-blue-600 dark:bg-blue-900/40 dark:text-blue-400",
  purple: "bg-purple-100 text-purple-600 dark:bg-purple-900/40 dark:text-purple-400",
  green: "bg-green-100 text-green-600 dark:bg-green-900/40 dark:text-green-400"
};
---

<div class="max-w-7xl mx-auto">
  
  <div class="text-center mb-16">
    <h2 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6">
      {t('skills.title1')} <span class="text-blue-600 dark:text-blue-400">{t('skills.title2')}</span>
    </h2>
    <div class="w-24 h-1 bg-gradient-to-r from-blue-500 to-purple-500 mx-auto rounded-full"></div>
    <p class="text-xl text-gray-600 dark:text-gray-300 mt-6 max-w-3xl mx-auto">
      {t('skills.desc')}
    </p>
  </div>

  <div class="space-y-16">
    {categories.map((category) => (
      <div>
        <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-8 flex items-center">
          <span class={`w-12 h-12 rounded-xl flex items-center justify-center mr-4 shadow-sm ${headerColorMap[category.color]}`}>
            <Icon name={category.icon} class="w-6 h-6" />
          </span>
          {category.title}
        </h3>
        
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-6 gap-4 lg:gap-6">
          {category.skills.map((skill) => (
            <div class="group bg-white dark:bg-gray-800/80 p-5 md:p-6 rounded-2xl shadow-sm hover:shadow-xl border border-gray-100 dark:border-gray-700/60 flex flex-col items-center justify-center text-center transition-all duration-300 hover:-translate-y-2 backdrop-blur-sm">
              <div class={`w-14 h-14 md:w-16 md:h-16 rounded-2xl flex items-center justify-center mb-4 transition-colors duration-300 shadow-inner ${colorMap[category.color]}`}>
                <Icon name={skill.icon} class="w-7 h-7 md:w-8 md:h-8" />
              </div>
              <span class="font-semibold text-gray-900 dark:text-gray-100 text-sm md:text-base group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                {skill.name}
              </span>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>