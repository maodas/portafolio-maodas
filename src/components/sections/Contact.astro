---
// ================= CONTACT (spec §3.7) =================
// No form. Direct links only + CV download CTA.
import { useTranslations } from '../../i18n/ui';
import DownloadCVModal from '../DownloadCVModal.astro';

const lang = Astro.currentLocale || 'en';
const t = useTranslations(lang as any);

const links = [
  {
    label:  'EMAIL',
    handle: 'maodas00@gmail.com',
    href:   'mailto:maodas00@gmail.com',
  },
  {
    label:  'LINKEDIN',
    handle: '/in/marcos-rodas',
    href:   'https://linkedin.com/in/marcos-rodas',
  },
  {
    label:  'GITHUB',
    handle: '/maodas',
    href:   'https://github.com/maodas',
  },
];
---

<section id="contact" class="contact-section max-w-content mx-auto px-12 py-16">

  <!-- Section label -->
  <h2 class="section-label font-mono mb-10">
    <span class="section-num">{t('contact.section.num')}</span>
    <span class="section-title">/ {t('contact.section.label')}</span>
  </h2>

  <!-- Two-column layout: text | links -->
  <div class="contact-grid">

    <!-- Left: pitch text -->
    <p class="contact-text font-sans" style="font-size: 1.05rem;">
      {t('contact.text')}
    </p>

    <!-- Right: direct links -->
    <div class="contact-links">
      {links.map(link => (
        <a
          href={link.href}
          target={link.href.startsWith('mailto') ? undefined : '_blank'}
          rel={link.href.startsWith('mailto') ? undefined : 'noopener noreferrer'}
          class="contact-link font-mono"
        >
          <span class="link-label font-mono">{link.label}</span>
          <span class="link-handle">{link.handle}</span>
        </a>
      ))}
    </div>

  </div>

  <!-- Full-width CV CTA -->
  <div class="cv-cta">
    <a
      href="#"
      onclick="event.preventDefault(); window.openCVModal && window.openCVModal(); return false;"
      class="cta-ghost font-mono"
    >
      {t('contact.cta.cv')}
    </a>
  </div>

</section>

<!-- Modal (kept as-is per spec §2) -->
<DownloadCVModal />

<style>
  /* Section separator */
  .contact-section {
    border-top: 1px solid var(--border);
  }

  /* Section label */
  .section-label {
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .section-num   { color: var(--accent); margin-right: 0.4rem; }
  .section-title { color: var(--muted); }

  /* ── Two-column grid ──────────────────────────────────────── */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
    margin-bottom: 3rem;
  }

  /* ── Left: pitch text ─────────────────────────────────────── */
  .contact-text {
    font-size: 1.05rem;
    font-weight: 300;
    color: var(--text);
    max-width: 340px;
    line-height: 1.7;
    margin: 0;
  }

  /* ── Right: links ─────────────────────────────────────────── */
  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.9rem 1.25rem;
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    color: var(--muted);
  }
  .contact-link:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #0e0e0e;
  }

  .link-label {
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 0.1em;
    transition: color 0.15s ease;
  }
  .contact-link:hover .link-label {
    color: #0e0e0e;
  }

  .link-handle {
    font-size: 0.95rem;
    color: var(--text);
    transition: color 0.15s ease;
  }
  .contact-link:hover .link-handle {
    color: #0e0e0e;
  }

  /* ── CV CTA ───────────────────────────────────────────────── */
  .cv-cta {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .cta-ghost {
    font-size: 0.95rem;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid var(--border-hi);
    padding: 0.75rem 0;
    display: inline-block;
    transition: color 0.15s ease;
    background: none;
    cursor: pointer;
  }
  .cta-ghost:hover {
    color: var(--text);
  }

  /* ── Mobile: stack columns ────────────────────────────────── */
  @media (max-width: 600px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .contact-text {
      max-width: 100%;
    }
  }
</style>