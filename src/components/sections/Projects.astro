---
// ================= PROJECTS (spec §3.5) =================
import { useTranslations } from '../../i18n/ui';

const lang = Astro.currentLocale || 'en';
const t = useTranslations(lang as any);

const projects = [
  {
    status:   t('proj.status.active'),
    active:   true,
    name:     t('proj.1.name'),
    problem:  t('proj.1.problem'),
    stack:    ['n8n', 'GCP', 'Firebase', 'Stripe', 'Tiledesk', 'Node.js'],
    codeUrl:  'https://github.com/maodas',
    demoUrl:  null,
  },
  {
    status:   t('proj.status.active'),
    active:   true,
    name:     t('proj.2.name'),
    problem:  t('proj.2.problem'),
    stack:    ['Twilio', 'Node.js', 'Render', 'GitHub'],
    codeUrl:  'https://github.com/maodas/verificador-n-meros-render',
    demoUrl:  'https://youtu.be/_K9cwxWZPL4',
  },
  {
    status:   t('proj.status.done'),
    active:   false,
    name:     t('proj.3.name'),
    problem:  t('proj.3.problem'),
    stack:    ['OpenAI', 'Python', 'Docker', 'PostgreSQL', 'Celery'],
    codeUrl:  'https://github.com/maodas/asistente-inteligente-multicanal',
    demoUrl:  'https://youtu.be/0ofnavIl1nE',
  },
  {
    status:   t('proj.status.done'),
    active:   false,
    name:     t('proj.4.name'),
    problem:  t('proj.4.problem'),
    stack:    ['MongoDB', 'Express', 'Node.js', 'Render'],
    codeUrl:  'https://github.com/maodas/portal-wifi-captive',
    demoUrl:  'https://portal-wifi-captive-site.onrender.com/',
  },
];

const codeLabel  = lang === 'es' ? 'código' : 'code';
const demoLabel  = 'demo';
---

<section id="projects" class="proj-section max-w-content mx-auto px-12 py-16">

  <!-- Section label -->
  <div class="section-label font-mono mb-8">
    <span class="section-num">{t('proj.section.num')}</span>
    <span class="section-title">/ {t('proj.section.label')}</span>
  </div>

  <!-- 2×2 project grid -->
  <div class="proj-grid">
    {projects.map((proj, i) => (
      <article class={`proj-card ${i % 2 === 0 ? 'card-left' : 'card-right'} ${i < 2 ? 'card-top' : 'card-bottom'}`}>

        <!-- Top row: status + arrow link -->
        <div class="card-header">
          <span class={`proj-status font-mono ${proj.active ? 'status-active' : 'status-done'}`}>
            {proj.status}
          </span>
          <div class="card-links font-mono">
            {proj.demoUrl && (
              <a href={proj.demoUrl} target="_blank" rel="noopener noreferrer" class="card-link" aria-label="Demo">
                {demoLabel} ↗
              </a>
            )}
            <a href={proj.codeUrl} target="_blank" rel="noopener noreferrer" class="card-link" aria-label="Code">
              {codeLabel} ↗
            </a>
          </div>
        </div>

        <!-- Project name -->
        <h3 class="proj-name font-sans" style="font-size: 0.95rem;">{proj.name}</h3>

        <!-- Problem statement -->
        <p class="proj-problem font-sans" style="font-size: 0.85rem;">{proj.problem}</p>

        <!-- Stack chips -->
        <div class="proj-stack">
          {proj.stack.map(tech => (
            <span class="stack-chip font-mono" style="font-size: 0.75rem;">{tech}</span>
          ))}
        </div>

      </article>
    ))}
  </div>

</section>

<style>
  /* Section separator + label */
  .proj-section {
    border-top: 1px solid var(--border);
  }

  .section-label {
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .section-num   { color: var(--accent); margin-right: 0.4rem; }
  .section-title { color: var(--muted); }

  /* ── Grid wrapper ─────────────────────────────────────────── */
  .proj-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }

  /* ── Cards ────────────────────────────────────────────────── */
  .proj-card {
    padding: 1.5rem;
    position: relative;
    transition: background 0.15s ease;
  }
  .proj-card:hover {
    background: rgba(255, 255, 255, 0.04);
  }

  /* Internal borders — right edge of left column */
  .card-left  { border-right: 1px solid var(--border); }
  /* Internal borders — bottom edge of top row */
  .card-top   { border-bottom: 1px solid var(--border); }

  /* ── Card header ──────────────────────────────────────────── */
  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .proj-status {
    font-size: 9px;
    letter-spacing: 0.04em;
  }
  .status-active { color: var(--accent); }
  .status-done   { color: var(--dim); }

  /* Links — hidden until hover for cleaner look */
  .card-links {
    display: flex;
    gap: 0.75rem;
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .proj-card:hover .card-links {
    opacity: 1;
  }

  .card-link {
    font-size: 9px;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .card-link:hover {
    color: var(--accent);
  }

  /* ── Project name ─────────────────────────────────────────── */
  .proj-name {
    font-size: 13px;
    font-weight: 400;
    color: var(--text);
    margin: 0 0 0.5rem 0;
    line-height: 1.4;
  }

  /* ── Problem statement ────────────────────────────────────── */
  .proj-problem {
    font-size: 11px;
    font-weight: 300;
    color: var(--muted);
    line-height: 1.6;
    margin: 0 0 1rem 0;
  }

  /* ── Stack chips ──────────────────────────────────────────── */
  .proj-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .stack-chip {
    font-size: 9px;
    background: var(--accent-dim);
    color: var(--accent);
    border-radius: 2px;
    padding: 2px 6px;
    line-height: 1.6;
  }

  /* ── Mobile — single column ───────────────────────────────── */
  @media (max-width: 560px) {
    .proj-grid {
      grid-template-columns: 1fr;
    }
    /* Reset column borders; keep row borders */
    .card-left  { border-right: none; }
    .card-top   { border-bottom: 1px solid var(--border); }
    /* All cards except last get a bottom border */
    .proj-card:not(:last-child) {
      border-bottom: 1px solid var(--border);
    }
    /* Remove double border from card-top on mobile */
    .card-bottom { border-bottom: none; }
  }
</style>