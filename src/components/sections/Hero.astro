---
// ================= HERO (spec §3.2 + §3.3) =================
import { useTranslations } from "../../i18n/ui";

const lang = Astro.currentLocale || "en";
const t = useTranslations(lang as any);
const basePath = lang === "es" ? "/es" : "";
---

<section class="hero-section max-w-content mx-auto px-12 py-20 md:py-28">
  <!-- Part A — Eyebrow -->
  <p class="hero-eyebrow font-mono mb-6" style="animation-delay: 0.1s;">
    {t("hero.eyebrow")}
  </p>

  <!-- Part B — Name + Tagline -->
  <h1 class="hero-name font-sans mb-6" style="animation-delay: 0.2s;">
    Marcos Rodas<br />
    <span class="hero-tagline">{t("hero.tagline")}</span>
  </h1>

  <!-- Part C — Voice paragraph -->
  <p class="hero-voice font-sans mb-10" style="animation-delay: 0.3s; font-size: 1.05rem; line-height: 1.8;">
    {t("hero.voice")}
  </p>

  <!-- Part D — Terminal -->
  <div class="terminal animate-fade-up" style="animation-delay: 0.45s;">
    <!-- macOS title bar -->
    <div class="terminal-bar">
      <div class="terminal-dots">
        <span style="background:#ff5f57;"></span>
        <span style="background:#febc2e;"></span>
        <span style="background:#28c840;"></span>
      </div>
      <span class="terminal-title font-mono">marcos@maodas ~ trajectory.sh</span
      >
    </div>

    <!-- Terminal body -->
    <div class="terminal-body font-mono">
      <!-- Command 1 -->
      <div class="t-line">
        <span class="t-prompt">$</span><span class="typed typed-1">
          ./describe --marcos</span
        >
      </div>

      <!-- Output 1 — fades in at 1.6s -->
      <div class="t-output t-out-1">
        <div>
          <span class="t-arrow">→</span> sales lead <span class="t-dim">·</span>
          <span class="t-val">2007</span> — managed 22 branches, Q2M/mo revenue
        </div>
        <div>
          <span class="t-arrow">→</span> ops manager <span class="t-dim">·</span
          >
          <span class="t-val">2013</span> — 30% error reduction, 100% uptime crisis
          mgmt
        </div>
        <div>
          <span class="t-arrow">→</span> PM + developer <span class="t-dim"
            >·</span
          >
          <span class="t-val">2023</span> — AI automation, digital platforms @ IOM
        </div>
      </div>

      <!-- Command 2 — appears at 2.2s -->
      <div class="t-line t-cmd-2">
        <span class="t-prompt">$</span><span class="typed typed-2">
          cat stack.txt</span
        >
      </div>

      <!-- Output 2 — fades in at 2.7s -->
      <div class="t-output t-out-2">
        <div>
          <span class="t-val">FastAPI</span> · LangGraph · n8n · Python · Astro · Supabase
          · GCP · Node.js
        </div>
      </div>

      <!-- Command 3 — appears at 3.2s -->
      <div class="t-line t-cmd-3">
        <span class="t-prompt">$</span><span class="typed typed-3">
          grep "available"</span
        >
      </div>

      <!-- Output 3 — fades in at 3.9s -->
      <div class="t-output t-out-3">
        <div>
          STATUS=<span class="t-val">open</span> · LOCATION=<span class="t-val"
            >Guatemala</span
          > · UTC-6 · RESPONSE=<span class="t-val">&lt;24h&gt;</span>
        </div>
      </div>

      <!-- Final prompt + blinking cursor — appears at 4.4s -->
      <div class="t-line t-final">
        <span class="t-prompt">$</span>
        <!-- cursor-wrap reveals at 4.4s; inner span blinks after that -->
        <span class="cursor-wrap"><span class="t-cursor">_</span></span>
      </div>
    </div>
  </div>

  <!-- Part E — CTAs -->
  <div class="hero-ctas animate-fade-up" style="animation-delay: 0.55s;">
    <a
      href={`${basePath}/#projects`}
      class="cta-primary font-mono"
      id="hero-portfolio-btn"
    >
      {t("hero.cta.portfolio")}
    </a>
    <a
      href="#"
      onclick="event.preventDefault(); window.openCVModal && window.openCVModal(); return false;"
      class="cta-ghost font-mono"
    >
      {t("hero.cta.cv")}
    </a>
  </div>

  <!-- Metrics strip (spec §3.3) -->
  <div class="metrics-strip animate-fade-up" style="animation-delay: 0.65s;">
    <div class="metric-cell">
      <div class="metric-number font-sans">
        15<span class="metric-suffix font-mono">+</span>
      </div>
      <div class="metric-label font-mono">{t("metrics.1.label")}</div>
    </div>

    <div class="metric-cell">
      <div class="metric-number font-sans">
        25<span class="metric-suffix font-mono">%</span>
      </div>
      <div class="metric-label font-mono">{t("metrics.2.label")}</div>
    </div>

    <div class="metric-cell metric-last">
      <div class="metric-number font-sans">
        30<span class="metric-suffix font-mono">%</span>
      </div>
      <div class="metric-label font-mono">{t("metrics.3.label")}</div>
    </div>
  </div>
</section>

<style>
  /* ── Shared hero animation base ───────────────────────────── */
  .hero-section > *,
  .animate-fade-up {
    opacity: 0;
    animation: fadeUp 0.5s ease both;
  }

  /* ── Part A — Eyebrow ────────────────────────────────────── */
  .hero-eyebrow {
    font-size: 11px;
    color: var(--accent);
    letter-spacing: 0.12em;
  }

  /* ── Part B — Name + Tagline ─────────────────────────────── */
  .hero-name {
    font-size: clamp(2.8rem, 4vw, 4.5rem);
    font-weight: 300;
    line-height: 1.1;
    color: var(--text);
    letter-spacing: -0.02em;
  }
  .hero-tagline {
    color: var(--muted);
  }

  /* ── Part C — Voice paragraph ────────────────────────────── */
  .hero-voice {
    font-size: 1.05rem !important;
    font-weight: 300;
    color: var(--muted);
    max-width: 520px;
    line-height: 1.8 !important;
  }

  /* ── Part D — Terminal ───────────────────────────────────── */
  .terminal {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 2rem;
    max-width: 600px;
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--border);
  }

  .terminal-dots {
    display: flex;
    gap: 6px;
  }
  .terminal-dots span {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: block;
  }

  .terminal-title {
    font-size: 10px;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .terminal-body {
    padding: 1.25rem 1.5rem 1.5rem;
    font-size: 14px;
    line-height: 2;
  }

  /* Prompt $ — accent colored */
  .t-prompt {
    color: var(--accent);
    user-select: none;
    margin-right: 0;
  }

  /* Typed command spans */
  .typed {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    vertical-align: bottom;
    width: 0;
    color: var(--text);
  }

  /* Output blocks */
  .t-output {
    opacity: 0;
    color: var(--muted);
    padding-left: 0.5rem;
    margin-bottom: 0.25rem;
  }

  /* Command lines 2 & 3 start hidden */
  .t-cmd-2,
  .t-cmd-3,
  .t-final {
    opacity: 0;
  }

  .t-line {
    display: flex;
    align-items: baseline;
  }

  .t-arrow {
    color: var(--muted);
    margin-right: 0.25rem;
  }
  .t-dim {
    color: var(--dim);
  }
  .t-val {
    color: var(--accent);
  }

  /* Cursor */
  .cursor-wrap {
    opacity: 0;
  }
  .t-cursor {
    color: var(--accent);
    font-size: 14px;
  }

  /* ── Part E — CTAs ───────────────────────────────────────── */
  .hero-ctas {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-top: 2.5rem;
    margin-bottom: 3rem;
  }

  .cta-primary {
    font-size: 0.95rem;
    background: var(--accent);
    color: #0e0e0e;
    border-radius: 4px;
    padding: 0.75rem 2rem;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  .cta-primary:hover {
    opacity: 0.88;
  }

  .cta-ghost {
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid var(--border-hi);
    padding-bottom: 1px;
    transition: color 0.15s ease;
  }
  .cta-ghost:hover {
    color: var(--text);
  }

  /* ── Metrics strip ───────────────────────────────────────── */
  .metrics-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .metric-cell {
    padding: 1.25rem 0;
    border-right: 1px solid var(--border);
    padding-left: 1.5rem;
  }
  .metric-last {
    border-right: none;
  }

  .metric-number {
    font-size: 2rem;
    font-weight: 300;
    line-height: 1;
    color: var(--text);
    margin-bottom: 0.3rem;
  }
  .metric-suffix {
    font-size: 1rem;
    color: var(--accent);
  }
  .metric-label {
    font-size: 11px;
    color: var(--muted);
  }

  /* ── Animations ──────────────────────────────────────────── */
  @media (prefers-reduced-motion: no-preference) {
    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes typeIn {
      from {
        width: 0;
      }
      to {
        width: var(--tw);
      }
    }

    @keyframes reveal {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }

    @keyframes blink {
      0%,
      100% {
        opacity: 1;
      }
      50% {
        opacity: 0;
      }
    }

    /* Typed commands */
    .typed-1 {
      --tw: 20ch;
      animation: typeIn 0.6s steps(20) forwards;
      animation-delay: 0.9s;
    }
    .typed-2 {
      --tw: 14ch;
      animation: typeIn 0.4s steps(14) forwards;
      animation-delay: 2.2s;
    }
    .typed-3 {
      --tw: 17ch;
      animation: typeIn 0.5s steps(17) forwards;
      animation-delay: 3.2s;
    }

    /* Outputs fade in */
    .t-out-1 {
      animation: reveal 0.35s ease forwards;
      animation-delay: 1.6s;
    }
    .t-out-2 {
      animation: reveal 0.35s ease forwards;
      animation-delay: 2.7s;
    }
    .t-out-3 {
      animation: reveal 0.35s ease forwards;
      animation-delay: 3.9s;
    }

    /* Command lines 2 & 3 appear before they start typing */
    .t-cmd-2 {
      animation: reveal 0.01s step-end forwards;
      animation-delay: 2.2s;
    }
    .t-cmd-3 {
      animation: reveal 0.01s step-end forwards;
      animation-delay: 3.2s;
    }

    /* Final prompt: reveal at 4.4s */
    .t-final {
      animation: reveal 0.01s step-end forwards;
      animation-delay: 4.4s;
    }

    /* Cursor:
     1. cursor-wrap reveals at 4.4s (opacity 0 → 1, fill-mode: forwards)
     2. t-cursor blinks continuously after 4.4s                          */
    .cursor-wrap {
      animation: reveal 0.01s step-end forwards;
      animation-delay: 4.4s;
    }
    .t-cursor {
      animation: blink 1.1s step-end infinite;
      animation-delay: 4.4s;
    }
  }

  /* Reduced-motion: show everything immediately */
  @media (prefers-reduced-motion: reduce) {
    .hero-section > *,
    .animate-fade-up,
    .typed,
    .t-output,
    .t-cmd-2,
    .t-cmd-3,
    .t-final,
    .cursor-wrap {
      opacity: 1 !important;
      width: var(--tw, auto) !important;
      animation: none !important;
    }
  }
</style>
