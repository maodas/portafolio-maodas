---
// ================= SECCIÓN SOBRE MÍ =================
import { useTranslations } from "../../i18n/ui";

const lang = Astro.currentLocale || "en";
const t = useTranslations(lang as any);
---

<div class="max-w-7xl mx-auto">
  <div class="text-center mb-16">
    <h2
      class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6"
    >
      {t("about.title1")}
      <span class="text-blue-600 dark:text-blue-400">{t("about.title2")}</span>
    </h2>
    <div
      class="w-24 h-1 bg-gradient-to-r from-blue-500 to-purple-500 mx-auto rounded-full"
    >
    </div>
    <p class="text-xl text-gray-600 dark:text-gray-300 mt-6 max-w-3xl mx-auto">
      {t("about.desc")}
    </p>
  </div>

  <div class="grid md:grid-cols-3 gap-12 items-start">
    <div class="space-y-8">
      <div class="relative group">
        <div
          class="absolute -inset-4 bg-gradient-to-r from-blue-500 to-purple-500 rounded-3xl blur-xl opacity-30 group-hover:opacity-50 transition duration-500"
        >
        </div>
        <div class="relative">
          <div
            class="w-64 h-64 mx-auto rounded-2xl overflow-hidden border-4 border-white dark:border-gray-800 shadow-2xl"
          >
            <img
              src="/images/fotop.png"
              alt="Foto de Marcos Rodas"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <div
              class="w-full h-full bg-gradient-to-br from-blue-400 to-purple-500 flex items-center justify-center"
            >
              <span class="text-6xl font-bold text-white">MD</span>
            </div>
          </div>
          <div
            class="absolute -bottom-4 -right-4 bg-green-500 text-white px-4 py-2 rounded-lg shadow-lg animate-[pulse_3s_ease-in-out_infinite]"
          >
            <span class="font-semibold">{t("about.badge")}</span>
          </div>
        </div>
      </div>

      <div
        class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-lg border border-gray-100 dark:border-gray-700"
      >
        <h3
          class="font-bold text-gray-900 dark:text-white mb-4 flex items-center"
        >
          <span class="w-3 h-3 bg-blue-500 rounded-full mr-3"></span>
          {t("about.contact.title")}
        </h3>
        <ul class="space-y-4">
          <li class="flex items-center text-gray-700 dark:text-gray-300">
            <svg
              class="w-5 h-5 text-blue-500 mr-3"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            maodas00@gmail.com
          </li>
          <li class="flex items-center text-gray-700 dark:text-gray-300">
            <svg
              class="w-5 h-5 text-blue-500 mr-3"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            {t("contact.info.location.val")}
          </li>
          <li class="flex items-center text-gray-700 dark:text-gray-300">
            <svg
              class="w-5 h-5 text-blue-500 mr-3"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            {t("contact.info.timezone.val")}
          </li>
        </ul>
      </div>
    </div>

    <div class="md:col-span-2 space-y-8">
      <div
        class="bg-white dark:bg-gray-800 rounded-2xl p-8 shadow-lg border border-gray-100 dark:border-gray-700"
      >
        <h3
          class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center"
        >
          <span
            class="w-8 h-8 bg-blue-100 dark:bg-blue-900/30 rounded-lg flex items-center justify-center mr-3"
          >
            <span class="text-blue-600 dark:text-blue-400">📖</span>
          </span>
          {t("about.history.title")}
        </h3>

        <div class="prose prose-lg dark:prose-invert max-w-none">
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            {t("about.history.p1")}
          </p>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            {t("about.history.p2")}
          </p>
          <p class="text-gray-700 dark:text-gray-300">
            {t("about.history.p3")}
          </p>
        </div>
      </div>

      <div
        class="bg-gradient-to-br from-blue-50 to-blue-100 dark:from-blue-900/20 dark:to-blue-800/20 rounded-2xl p-8 shadow-lg border border-blue-100 dark:border-blue-800/30"
      >
        <h3
          class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center"
        >
          <span
            class="w-8 h-8 bg-blue-500 rounded-lg flex items-center justify-center mr-3"
          >
            <span class="text-white">💡</span>
          </span>
          {t("about.philosophy.title")}
        </h3>

        <div class="grid sm:grid-cols-2 gap-6">
          <div
            class="bg-white/50 dark:bg-gray-800/50 backdrop-blur-sm p-6 rounded-xl border border-blue-100 dark:border-blue-800/30"
          >
            <div
              class="w-12 h-12 bg-blue-100 dark:bg-blue-900/30 rounded-lg flex items-center justify-center mb-4"
            >
              <span class="text-2xl">🎯</span>
            </div>
            <h4 class="font-bold text-gray-900 dark:text-white mb-2">
              {t("about.philosophy.item1.title")}
            </h4>
            <p class="text-gray-700 dark:text-gray-300 text-sm">
              {t("about.philosophy.item1.desc")}
            </p>
          </div>

          <div
            class="bg-white/50 dark:bg-gray-800/50 backdrop-blur-sm p-6 rounded-xl border border-blue-100 dark:border-blue-800/30"
          >
            <div
              class="w-12 h-12 bg-blue-100 dark:bg-blue-900/30 rounded-lg flex items-center justify-center mb-4"
            >
              <span class="text-2xl">🔄</span>
            </div>
            <h4 class="font-bold text-gray-900 dark:text-white mb-2">
              {t("about.philosophy.item2.title")}
            </h4>
            <p class="text-gray-700 dark:text-gray-300 text-sm">
              {t("about.philosophy.item2.desc")}
            </p>
          </div>

          <div
            class="bg-white/50 dark:bg-gray-800/50 backdrop-blur-sm p-6 rounded-xl border border-blue-100 dark:border-blue-800/30"
          >
            <div
              class="w-12 h-12 bg-blue-100 dark:bg-blue-900/30 rounded-lg flex items-center justify-center mb-4"
            >
              <span class="text-2xl">🤝</span>
            </div>
            <h4 class="font-bold text-gray-900 dark:text-white mb-2">
              {t("about.philosophy.item3.title")}
            </h4>
            <p class="text-gray-700 dark:text-gray-300 text-sm">
              {t("about.philosophy.item3.desc")}
            </p>
          </div>

          <div
            class="bg-white/50 dark:bg-gray-800/50 backdrop-blur-sm p-6 rounded-xl border border-blue-100 dark:border-blue-800/30"
          >
            <div
              class="w-12 h-12 bg-blue-100 dark:bg-blue-900/30 rounded-lg flex items-center justify-center mb-4"
            >
              <span class="text-2xl">🧠</span>
            </div>
            <h4 class="font-bold text-gray-900 dark:text-white mb-2">
              {t("about.philosophy.item4.title")}
            </h4>
            <p class="text-gray-700 dark:text-gray-300 text-sm">
              {t("about.philosophy.item4.desc")}
            </p>
          </div>
        </div>
      </div>

      <div
        class="bg-white dark:bg-gray-800 rounded-2xl p-8 shadow-lg border border-gray-100 dark:border-gray-700"
      >
        <h3
          class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center"
        >
          <span
            class="w-8 h-8 bg-purple-100 dark:bg-purple-900/30 rounded-lg flex items-center justify-center mr-3"
          >
            <span class="text-purple-600 dark:text-purple-400">🎨</span>
          </span>
          {t("about.interests.title")}
        </h3>

        <div class="flex flex-wrap gap-3">
          <span
            class="px-4 py-2 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full font-medium"
            >{t("about.interests.i1")}</span
          >
          <span
            class="px-4 py-2 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 rounded-full font-medium"
            >{t("about.interests.i2")}</span
          >
          <span
            class="px-4 py-2 bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded-full font-medium"
            >{t("about.interests.i3")}</span
          >
          <span
            class="px-4 py-2 bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300 rounded-full font-medium"
            >{t("about.interests.i4")}</span
          >
          <span
            class="px-4 py-2 bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300 rounded-full font-medium"
            >{t("about.interests.i5")}</span
          >
          <span
            class="px-4 py-2 bg-indigo-100 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 rounded-full font-medium"
            >{t("about.interests.i6")}</span
          >
          <span
            class="px-4 py-2 bg-pink-100 dark:bg-pink-900/30 text-pink-700 dark:text-pink-300 rounded-full font-medium"
            >{t("about.interests.i7")}</span
          >
          <span
            class="px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full font-medium"
            >{t("about.interests.i8")}</span
          >
        </div>
      </div>
    </div>
  </div>

  <div class="mt-16">
    <div class="text-center mb-12">
      <h3 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">
        <span class="text-blue-600 dark:text-blue-400">🎓</span>
        {t("about.edu.title1")}
      </h3>
      <p class="text-gray-600 dark:text-gray-300">{t("about.edu.desc")}</p>
    </div>

    <div class="relative">
      <div
        class="absolute left-1/2 transform -translate-x-1/2 h-full w-0.5 bg-gradient-to-b from-blue-400 to-purple-400 hidden md:block"
      >
      </div>

      <div class="space-y-12">
        <div class="relative md:flex items-center">
          <div class="md:w-1/2 md:pr-12 md:text-right mb-6 md:mb-0">
            <div
              class="bg-white dark:bg-gray-800 p-6 rounded-2xl shadow-lg border border-gray-100 dark:border-gray-700"
            >
              <span
                class="inline-block px-3 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 text-sm font-semibold rounded-full mb-3"
              >
                {t("about.edu.item1.date")}
              </span>
              <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
                {t("about.edu.item1.title")}
              </h4>
              <p class="text-gray-600 dark:text-gray-300">
                {t("about.edu.item1.desc")}
              </p>
              <div class="mt-4 flex items-center justify-end">
                <span class="text-sm text-gray-500 dark:text-gray-400"
                  >Universidad Galileo - Guatemala</span
                >
              </div>
            </div>
          </div>
          <div
            class="hidden md:flex w-6 h-6 absolute left-1/2 transform -translate-x-1/2 rounded-full bg-blue-500 border-4 border-white dark:border-gray-900 shadow-lg"
          >
          </div>
          <div class="md:w-1/2 md:pl-12"></div>
        </div>

        <div class="relative md:flex items-center">
          <div class="md:w-1/2 md:pr-12 md:text-right"></div>
          <div
            class="hidden md:flex w-6 h-6 absolute left-1/2 transform -translate-x-1/2 rounded-full bg-purple-500 border-4 border-white dark:border-gray-900 shadow-lg"
          >
          </div>

          <div class="md:w-1/2 md:pl-12 mt-6 md:mt-0">
            <div
              class="bg-white dark:bg-gray-800 p-6 rounded-2xl shadow-lg border border-gray-100 dark:border-gray-700"
            >
              <span
                class="inline-block px-3 py-1 bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 text-sm font-semibold rounded-full mb-3"
              >
                {t("about.edu.item2.date")}
              </span>
              <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
                {t("about.edu.item2.title")}
              </h4>
              <p class="text-gray-600 dark:text-gray-300">
                {t("about.edu.item2.desc")}
              </p>
              <div class="mt-4 flex items-center">
                <span class="text-sm text-gray-500 dark:text-gray-400"
                  >Universidad Galileo - Guatemala</span
                >
              </div>
            </div>
          </div>
        </div>

        <div class="relative md:flex items-center">
          <div class="md:w-1/2 md:pr-12 md:text-right mb-6 md:mb-0">
            <div
              class="bg-white dark:bg-gray-800 p-6 rounded-2xl shadow-lg border border-gray-100 dark:border-gray-700"
            >
              <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
                {t("about.edu.item3.title")}
              </h4>
              <p class="text-gray-600 dark:text-gray-300">
                {t("about.edu.item3.desc")}
              </p>
              <div class="mt-4 flex items-center justify-end">
                <span class="text-sm text-gray-500 dark:text-gray-400"
                  >Google - Coursera</span
                >
              </div>
            </div>
          </div>
          <div
            class="hidden md:flex w-6 h-6 absolute left-1/2 transform -translate-x-1/2 rounded-full bg-green-500 border-4 border-white dark:border-gray-900 shadow-lg"
          >
          </div>
          <div class="md:w-1/2 md:pl-12"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .prose p {
    line-height: 1.8;
    margin-bottom: 1rem;
  }
  .bg-white,
  .bg-gray-800 {
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }
  .bg-white:hover,
  .bg-gray-800:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
  }
  @media (max-width: 768px) {
    .relative.md\:flex {
      flex-direction: column;
    }
    .md\:w-1\/2 {
      width: 100%;
    }
    .md\:pr-12,
    .md\:pl-12 {
      padding-right: 0;
      padding-left: 0;
    }
    .md\:text-right {
      text-align: left;
    }
  }
</style>
