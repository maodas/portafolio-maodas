---
// ================= EXPERIENCE (spec §3.4) =================
import { useTranslations } from '../../i18n/ui';

const lang = Astro.currentLocale || 'en';
const t = useTranslations(lang as any);

const roles = [
  {
    period:   lang === 'es' ? '2023 – presente' : '2023 – present',
    title:    lang === 'es'
      ? 'Coordinador de Proyectos — Plataformas Digitales'
      : 'Project Coordinator — Digital Platforms',
    org:      'IOM (RRP)',
    impactBullets: lang === 'es' ? [
      'Lideré la modernización de servicios digitales públicos de alta demanda, traduciendo requisitos complejos en arquitecturas técnicas escalables.',
      'Desarrollé herramientas de automatización que eliminaron cuellos de botella operativos e integré flujos impulsados por IA.',
      'Gestioné el ciclo completo de proyectos en equipos multifuncionales dentro de un entorno internacional de alta responsabilidad.'
    ] : [
      'Led modernization of high-demand public digital services, translating complex stakeholder requirements into scalable technical architectures.',
      'Built automation tools that eliminated operational bottlenecks and integrated AI-driven workflows to reduce response times.',
      'Managed full project lifecycle across cross-functional teams in a high-accountability international environment.'
    ],
    tags:     ['Astro', 'Node.js', 'Python', 'n8n', 'GCP', 'IOM'],
    current:  true,
  },
  {
    period:   lang === 'es' ? 'Feb 2013 – Ago 2023' : 'Feb 2013 – Aug 2023',
    title:    lang === 'es'
      ? 'Especialista en Automatización de Sistemas y Flujos de Trabajo'
      : 'Lead Systems & Workflow Automation Specialist',
    org:      'IDC Los Tres, S.A.',
    impactBullets: lang === 'es' ? [
      'A lo largo de una década, evolucione de gestionar operaciones logísticas en 22 ubicaciones a arquitectar la transformación digital de la empresa — rediseñando flujos manuales que redujeron errores de envío un 30%, y construyendo pipelines de datos automatizados que comprimieron latencias operativas regionales un 40%.',
      'Desarrollé herramientas de scripting y procedimientos SQL para limpiar, normalizar y validar registros logísticos de alto volumen — estableciendo la infraestructura de reportes automatizados que reemplazó los últimos cuellos de botella manuales en equipos de 10+ personas.',
      'Fui el puente entre operaciones de campo y los equipos técnicos: traduciendo fallas de proceso en backlogs estructurados en Jira, facilitando sincronizaciones multifuncionales semanales y manteniendo entregas dentro de alcance y presupuesto durante toda la transición.'
    ] : [
      'Over a decade, evolved from managing logistics operations across 22 locations to architecting the company\'s digital transformation — redesigning manual workflows that cut shipping errors by 30%, then building automated data pipelines that compressed regional turnaround latencies by 40%.',
      'Developed custom scripting tools and SQL data procedures to clean, normalize, and validate high-volume logistics records — establishing the automated reporting infrastructure that replaced the last manual bottlenecks across 10+ person teams.',
      'Served as the bridge between field operations and engineering throughout the full transformation: translating process failures into structured Jira backlogs, running weekly cross-functional syncs, and keeping every improvement on scope and budget.'
    ],
    tags:     ['SQL', 'Python', 'Jira', 'PowerBI', 'Data Pipelines', 'Automation', 'Process Design'],
    current: false,
  },
  {
    period:   '2007 – 2012',
    title:    lang === 'es' ? 'Supervisor Regional de Ventas' : 'Regional Sales Supervisor',
    org:      lang === 'es' ? 'Calzado Matrix · 22 sucursales' : 'Calzado Matrix · 22 branches',
    impactBullets: lang === 'es' ? [
      'Gestioné el rendimiento comercial de 22 sucursales, superando metas mensuales mediante métricas de seguimiento y estandarización de procesos.',
      'Construí y escalé procesos de ventas regionales desde cero, convirtiendo sucursales de bajo rendimiento en contribuidores consistentes.',
      'Desarrollé la disciplina operativa y de reporte que estructuró los fundamentos de mi carrera en gestión de operaciones y equipos.'
    ] : [
      'Managed commercial performance across 22 branches, consistently hitting monthly targets through tracking metrics and process standardization.',
      'Built and scaled regional sales processes from scratch, turning underperforming branches into consistent contributors.',
      'Developed the operational and reporting discipline that became the foundation of my career in operations and team management.'
    ],
    tags:     ['Sales Ops', 'Reporting', 'Team Mgmt', 'Process Standardization'],
    current: false,
  },
];

const eduItems = [
  { period: t('exp.edu.1.period'), title: t('exp.edu.1.title') },
  { period: t('exp.edu.2.period'), title: t('exp.edu.2.title') },
  { period: '',                    title: t('exp.edu.3.title') },
];
---

<section id="experience" class="exp-section max-w-content mx-auto px-12 py-16">

  <!-- Section label -->
  <div class="section-label font-mono mb-10">
    <span class="section-num">{t('exp.section.num')}</span>
    <span class="section-title">/ {t('exp.section.label')}</span>
  </div>

  <!-- Roles -->
  <div class="roles-list">
    {roles.map((role, i) => (
      <div class={`role-row ${i === roles.length - 1 ? 'role-last' : ''}`}>

        <!-- Two-column grid -->
        <div class="role-grid">

          <!-- Left: period -->
          <div class="role-period font-mono">
            {role.period}
            {role.current && <span class="current-dot" />}
          </div>

          <!-- Right: content -->
          <div class="role-content">
            <div class="role-title font-sans" style="font-size: 1rem;">{role.title}</div>
            <div class="role-org font-mono" style="font-size: 0.85rem;">{role.org}</div>
            <ul class="role-impact font-sans" style="font-size: 0.95rem; line-height: 1.75; list-style-type: disc; margin-left: 1.2rem; margin-bottom: 0.75rem;">
              {role.impactBullets.map(bullet => (
                <li style="margin-bottom: 0.4rem;">{bullet}</li>
              ))}
            </ul>
            <div class="role-tags">
              {role.tags.map(tag => (
                <span class="tag font-mono" style="font-size: 0.75rem;">{tag}</span>
              ))}
            </div>
          </div>

        </div>
      </div>
    ))}
  </div>

  <!-- Education — same two-column layout, no descriptions -->
  <div class="edu-block">
    <div class="edu-label font-mono">{t('exp.edu.label')}</div>
    {eduItems.map(item => (
      <div class="edu-row">
        <div class="edu-period font-mono">{item.period}</div>
        <div class="edu-title font-mono">{item.title}</div>
      </div>
    ))}
  </div>

</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    
    if (prefersReducedMotion) {
      // If reduced motion is preferred, show all tags immediately
      document.querySelectorAll('[class*="tag"]').forEach(tag => {
        tag.style.opacity = '1';
        tag.style.transition = 'none';
      });
      return;
    }

    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const tags = entry.target.querySelectorAll('[class*="tag"]');
          tags.forEach((tag, index) => {
            setTimeout(() => {
              tag.classList.add('is-visible');
            }, index * 60);
          });
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('[class*="role-tags"]').forEach(container => {
      observer.observe(container);
    });
  });
</script>

<style is:global>
  /* Section separator */
  .exp-section {
    border-top: 1px solid var(--border);
  }

  /* Section label */
  .section-label {
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .section-num {
    color: var(--accent);
    margin-right: 0.4rem;
  }
  .section-title {
    color: var(--muted);
  }

  /* Roles list */
  .roles-list {
    display: flex;
    flex-direction: column;
  }

  .role-row {
    border-bottom: 1px solid var(--border);
    padding: 2rem 0;
  }
  .role-last {
    border-bottom: none;
  }

  /* Two-column role grid */
  .role-grid {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 0 2rem;
  }

  /* Left column — period */
  .role-period {
    font-size: 0.8rem;
    color: var(--muted);
    opacity: 1;
    padding-top: 2px;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  /* Current role indicator — small accent dot */
  .current-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* Right column */
  .role-title {
    font-size: 13px;
    font-weight: 400;
    color: var(--text);
    margin-bottom: 0.2rem;
  }
  .role-org {
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 0.6rem;
  }
  .role-impact {
    font-size: 13px;
    font-weight: 300;
    color: var(--text);
    line-height: 1.75;
    margin: 0 0 0.75rem 0;
    max-width: 540px;
  }

  /* Stack tags */
  .role-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tag {
    font-size: 10px;
    color: var(--muted);
    border: 1px solid var(--border-hi);
    border-radius: 3px;
    line-height: 1.6;
  }
  


  /* Education block */
  .edu-block {
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
    margin-top: 0.5rem;
  }

  .edu-label {
    font-size: 10px;
    color: var(--accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .edu-row {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 0 2rem;
    padding: 0.35rem 0;
  }

  .edu-period {
    font-size: 0.85rem;
    color: var(--muted);
    opacity: 1;
  }

  .edu-title {
    font-size: 0.85rem;
    color: var(--muted);
  }

  /* Mobile — stack columns */
  @media (max-width: 560px) {
    .role-grid,
    .edu-row {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
    .role-period {
      flex-direction: row;
      align-items: center;
      gap: 0.5rem;
    }
  }
</style>