---
// ================= EXPERIENCE (spec §3.4) =================
import { useTranslations } from '../../i18n/ui';

const lang = Astro.currentLocale || 'en';
const t = useTranslations(lang as any);

const roles = [
  {
    period:   lang === 'es' ? '2023 – presente' : '2023 – present',
    title:    lang === 'es'
      ? 'Coordinador de Proyectos — Plataformas Digitales'
      : 'Project Coordinator — Digital Platforms',
    org:      lang === 'es' ? 'IOM (RRP) · Tiempo completo' : 'IOM (RRP) · Full-time',
    impact:   t('exp.1.impact'),
    tags:     ['Scrum', 'AI Automation', 'Python', 'SQL', lang === 'es' ? 'Infraestructura' : 'Infrastructure'],
    current:  true,
  },
  {
    period:   '2013 – 2023',
    title:    lang === 'es' ? 'Sub-Gerente de Operaciones' : 'Operations Sub-Manager',
    org:      lang === 'es' ? 'IDC Los Tres, S.A. · Tiempo completo' : 'IDC Los Tres, S.A. · Full-time',
    impact:   t('exp.2.impact'),
    tags:     [
      lang === 'es' ? 'Liderazgo' : 'Leadership',
      lang === 'es' ? 'Gestión de Riesgo' : 'Risk Management',
      lang === 'es' ? 'Reingeniería de Procesos' : 'Process Reengineering',
    ],
    current: false,
  },
  {
    period:   '2007 – 2012',
    title:    lang === 'es' ? 'Supervisor Regional de Ventas' : 'Regional Sales Supervisor',
    org:      lang === 'es' ? 'Calzado Matrix · 22 sucursales' : 'Calzado Matrix · 22 branches',
    impact:   t('exp.3.impact'),
    tags:     [
      lang === 'es' ? 'Estrategia Comercial' : 'Commercial Strategy',
      lang === 'es' ? 'Liderazgo' : 'Leadership',
      lang === 'es' ? 'Mejora de Procesos' : 'Process Improvement',
    ],
    current: false,
  },
];

const eduItems = [
  { period: t('exp.edu.1.period'), title: t('exp.edu.1.title') },
  { period: t('exp.edu.2.period'), title: t('exp.edu.2.title') },
  { period: '',                    title: t('exp.edu.3.title') },
];
---

<section id="experience" class="exp-section max-w-content mx-auto px-12 py-16">

  <!-- Section label -->
  <div class="section-label font-mono mb-10">
    <span class="section-num">{t('exp.section.num')}</span>
    <span class="section-title">/ {t('exp.section.label')}</span>
  </div>

  <!-- Roles -->
  <div class="roles-list">
    {roles.map((role, i) => (
      <div class={`role-row ${i === roles.length - 1 ? 'role-last' : ''}`}>

        <!-- Two-column grid -->
        <div class="role-grid">

          <!-- Left: period -->
          <div class="role-period font-mono">
            {role.period}
            {role.current && <span class="current-dot" />}
          </div>

          <!-- Right: content -->
          <div class="role-content">
            <div class="role-title font-sans" style="font-size: 1rem;">{role.title}</div>
            <div class="role-org font-mono" style="font-size: 0.85rem;">{role.org}</div>
            <p class="role-impact font-sans" style="font-size: 0.95rem; line-height: 1.75;">{role.impact}</p>
            <div class="role-tags">
              {role.tags.map(tag => (
                <span class="tag font-mono" style="font-size: 0.75rem;">{tag}</span>
              ))}
            </div>
          </div>

        </div>
      </div>
    ))}
  </div>

  <!-- Education — same two-column layout, no descriptions -->
  <div class="edu-block">
    <div class="edu-label font-mono">{t('exp.edu.label')}</div>
    {eduItems.map(item => (
      <div class="edu-row">
        <div class="edu-period font-mono">{item.period}</div>
        <div class="edu-title font-mono">{item.title}</div>
      </div>
    ))}
  </div>

</section>

<style>
  /* Section separator */
  .exp-section {
    border-top: 1px solid var(--border);
  }

  /* Section label */
  .section-label {
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .section-num {
    color: var(--accent);
    margin-right: 0.4rem;
  }
  .section-title {
    color: var(--muted);
  }

  /* Roles list */
  .roles-list {
    display: flex;
    flex-direction: column;
  }

  .role-row {
    border-bottom: 1px solid var(--border);
    padding: 2rem 0;
  }
  .role-last {
    border-bottom: none;
  }

  /* Two-column role grid */
  .role-grid {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 0 2rem;
  }

  /* Left column — period */
  .role-period {
    font-size: 0.8rem;
    color: var(--muted);
    opacity: 1;
    padding-top: 2px;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  /* Current role indicator — small accent dot */
  .current-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* Right column */
  .role-title {
    font-size: 13px;
    font-weight: 400;
    color: var(--text);
    margin-bottom: 0.2rem;
  }
  .role-org {
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 0.6rem;
  }
  .role-impact {
    font-size: 13px;
    font-weight: 300;
    color: var(--text);
    line-height: 1.75;
    margin: 0 0 0.75rem 0;
    max-width: 540px;
  }

  /* Stack tags */
  .role-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tag {
    font-size: 10px;
    color: var(--muted);
    border: 1px solid var(--border-hi);
    border-radius: 3px;
    padding: 2px 7px;
    line-height: 1.6;
  }

  /* Education block */
  .edu-block {
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
    margin-top: 0.5rem;
  }

  .edu-label {
    font-size: 10px;
    color: var(--accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .edu-row {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 0 2rem;
    padding: 0.35rem 0;
  }

  .edu-period {
    font-size: 0.85rem;
    color: var(--muted);
    opacity: 1;
  }

  .edu-title {
    font-size: 0.85rem;
    color: var(--muted);
  }

  /* Mobile — stack columns */
  @media (max-width: 560px) {
    .role-grid,
    .edu-row {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
    .role-period {
      flex-direction: row;
      align-items: center;
      gap: 0.5rem;
    }
  }
</style>