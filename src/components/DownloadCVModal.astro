---
// DownloadCVModal — restyled to match design system (correction #4)
import { useTranslations } from '../i18n/ui';

const lang = Astro.currentLocale || 'en';
const t = useTranslations(lang as any);
---

<div id="cv-modal" class="modal-backdrop hidden">
  <div id="modal-content" class="modal-box font-sans">

    <h3 class="modal-title font-sans">{t('cv.modal.title')}</h3>
    <p class="modal-desc font-mono">{t('cv.modal.desc')}</p>

    <div class="modal-buttons">
      <a href="/cv-Marcos_Rodas-es.pdf" download class="btn-primary font-mono">
        Español
      </a>
      <a href="/cv-Marcos_Rodas-en.pdf" download class="btn-primary font-mono">
        English
      </a>
    </div>

    <button id="close-modal" class="btn-close font-mono">
      {t('cv.modal.close')}
    </button>

  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const modal        = document.getElementById('cv-modal');
    const modalContent = document.getElementById('modal-content');
    const closeBtn     = document.getElementById('close-modal');

    (window as any).openCVModal = function() {
      if (!modal) return;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      // Tiny delay so the transition has an initial state to animate from
      requestAnimationFrame(() => {
        modalContent?.classList.add('modal-visible');
      });
    };

    function closeModal() {
      modalContent?.classList.remove('modal-visible');
      setTimeout(() => {
        modal?.classList.remove('flex');
        modal?.classList.add('hidden');
      }, 200);
    }

    closeBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  });
</script>

<style>
  /* Backdrop */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 100;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
  }

  /* Modal box */
  .modal-box {
    background: var(--surface);
    border: 1px solid var(--border-hi);
    border-radius: 8px;
    padding: 2rem;
    max-width: 400px;
    width: 100%;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .modal-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Title */
  .modal-title {
    font-size: 1.1rem;
    font-weight: 300;
    color: var(--text);
    margin: 0 0 0.5rem 0;
  }

  /* Subtitle */
  .modal-desc {
    font-size: 11px;
    color: var(--muted);
    margin: 0 0 1.5rem 0;
    line-height: 1.6;
  }

  /* Download buttons */
  .modal-buttons {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .btn-primary {
    flex: 1;
    display: block;
    text-align: center;
    font-size: 12px;
    background: var(--accent);
    color: #0e0e0e;
    border-radius: 4px;
    padding: 0.55rem 1.5rem;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  .btn-primary:hover {
    opacity: 0.88;
  }

  /* Close link */
  .btn-close {
    display: block;
    width: 100%;
    font-size: 11px;
    color: var(--muted);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    text-align: center;
    transition: color 0.15s ease;
  }
  .btn-close:hover {
    color: var(--text);
  }
</style>