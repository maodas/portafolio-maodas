---
// Componente Modal para seleccionar idioma del CV
import { useTranslations } from '../i18n/ui';

const lang = Astro.currentLocale || 'en';
const t = useTranslations(lang as any);
---

<div id="cv-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/50 backdrop-blur-sm transition-opacity">
  <div class="bg-white dark:bg-gray-800 rounded-2xl max-w-md w-full p-8 shadow-2xl transform transition-all scale-95 opacity-0" id="modal-content">
    <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">{t('cv.modal.title')}</h3>
    <p class="text-gray-600 dark:text-gray-300 mb-6">{t('cv.modal.desc')}</p>
    
    <div class="flex flex-col sm:flex-row gap-4">
      <a href="/cv-Marcos_Rodas-es.pdf" download class="flex-1 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl text-center transition-colors">
        🇬🇹 Español
      </a>
      <a href="/cv-Marcos_Rodas-en.pdf" download class="flex-1 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl text-center transition-colors">
        🇺🇸 English
      </a>
    </div>
    
    <button id="close-modal" class="mt-6 w-full px-4 py-2 text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 transition-colors">
      {t('cv.modal.close')}
    </button>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const modal = document.getElementById('cv-modal');
    const modalContent = document.getElementById('modal-content');
    const closeBtn = document.getElementById('close-modal');

    (window as any).openCVModal = function() {
      if (!modal || !modalContent) return;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      setTimeout(() => {
        modalContent.classList.remove('scale-95', 'opacity-0');
        modalContent.classList.add('scale-100', 'opacity-100');
      }, 10);
    };

    function closeModal() {
      if (!modalContent) return;
      modalContent.classList.remove('scale-100', 'opacity-100');
      modalContent.classList.add('scale-95', 'opacity-0');
      setTimeout(() => {
        if (modal) {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }
      }, 300);
    }

    if (closeBtn) {
      closeBtn.onclick = closeModal;
    }

    if (modal) {
      modal.onclick = (e) => {
        if (e.target === modal) {
          closeModal();
        }
      };
    }
  });
</script>